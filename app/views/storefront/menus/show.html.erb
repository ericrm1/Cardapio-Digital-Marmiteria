<% content_for :title, @restaurant.name %>

<header class="mb-4">
  <div class="flex items-center gap-3">
    <% if @restaurant.logo.attached? %>
      <%= image_tag @restaurant.logo.variant(resize_to_limit: [ 64, 64 ]), class: "h-14 w-14 rounded-full object-cover" %>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold"><%= @restaurant.name %></h1>
      <% if @availability.available? %>
        <p class="text-sm text-emerald-600">🟢 Aceitando pedidos</p>
      <% elsif @availability.reason == :not_accepting_orders %>
        <p class="text-sm text-red-600">🔴 Pedidos encerrados no momento.</p>
      <% else %>
        <p class="text-sm text-red-600">🔴 Estamos fechados no momento.</p>
      <% end %>
    </div>
  </div>
</header>

<% if @categories.any? %>
  <nav class="mb-4 flex gap-2 overflow-x-auto pb-2">
    <% @categories.each do |category| %>
      <a href="#category-<%= category.id %>" class="whitespace-nowrap rounded-full bg-white px-4 py-1.5 text-sm font-medium text-gray-700 shadow-sm">
        <%= category.name %>
      </a>
    <% end %>
  </nav>

  <div class="space-y-8">
    <% @categories.each do |category| %>
      <% products = category.active_products %>
      <% next if products.empty? %>

      <section id="category-<%= category.id %>">
        <h2 class="mb-3 text-lg font-semibold"><%= category.name %></h2>

        <div class="space-y-3">
          <% products.each do |product| %>
            <%= link_to storefront_product_path(@restaurant.slug, product), class: "flex gap-3 rounded-xl bg-white p-3 shadow-sm" do %>
              <% if product.image.attached? %>
                <%= image_tag product.image.variant(resize_to_limit: [ 96, 96 ]), class: "h-20 w-20 flex-none rounded-lg object-cover" %>
              <% end %>
              <div class="flex-1">
                <p class="font-medium text-gray-900"><%= product.name %></p>
                <% if product.description.present? %>
                  <p class="mt-1 line-clamp-2 text-sm text-gray-500"><%= product.description %></p>
                <% end %>
                <p class="mt-2 font-semibold text-emerald-700"><%= brl(product.price) %></p>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">Nenhum produto disponível no momento.</p>
<% end %>
