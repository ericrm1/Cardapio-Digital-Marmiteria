<div class="rounded-2xl bg-white p-8 shadow-sm">
  <h1 class="mb-6 text-xl font-semibold text-gray-900">Entrar no painel</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
        <%= f.label :remember_me, "Lembrar de mim", class: "text-sm text-gray-600" %>
      </div>
    <% end %>

    <%= f.submit "Entrar", class: "w-full rounded-lg bg-emerald-600 py-2 font-medium text-white hover:bg-emerald-700" %>
  <% end %>

  <div class="mt-4 text-sm text-gray-500">
    <%= render "devise/shared/links" %>
  </div>
</div>
