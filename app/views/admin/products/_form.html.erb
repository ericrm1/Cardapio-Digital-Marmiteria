<%= form_with model: [ :admin, product ], html: { multipart: true, class: "space-y-4 rounded-xl bg-white p-6 shadow-sm" } do |f| %>
  <% if product.errors.any? %>
    <div class="rounded-lg bg-red-100 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :description, "Descrição", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 3, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :price, "Preço (R$)", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.number_field :price, step: "0.01", min: 0, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>

    <div>
      <%= f.label :category_id, "Categoria", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { prompt: true }, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= f.label :position, "Posição", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.number_field :position, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :image, "Imagem", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <% if product.image.attached? %>
      <%= image_tag product.image.variant(resize_to_limit: [ 120, 120 ]), class: "mb-2 rounded-lg" %>
    <% end %>
    <%= f.file_field :image, accept: "image/*", class: "block w-full text-sm" %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300" %>
    <%= f.label :active, "Ativo", class: "text-sm text-gray-700" %>
  </div>

  <div>
    <p class="mb-2 text-sm font-medium text-gray-700">Adicionais disponíveis</p>
    <div class="space-y-1">
      <% @addons.each do |addon| %>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= check_box_tag "product[addon_ids][]", addon.id, product.addon_ids.include?(addon.id), id: "addon_#{addon.id}", class: "rounded border-gray-300" %>
          <%= addon.name %> (<%= brl(addon.price) %>)
        </label>
      <% end %>
    </div>
    <%= hidden_field_tag "product[addon_ids][]", "" %>
  </div>

  <%= f.submit "Salvar produto", class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700" %>
<% end %>
