<% content_for :title, "Categorias" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold">Categorias</h1>
  <%= link_to "Nova categoria", new_admin_category_path, class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700" %>
</div>

<div class="overflow-hidden rounded-xl bg-white shadow-sm">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-500">
      <tr>
        <th class="px-4 py-3">Posição</th>
        <th class="px-4 py-3">Nome</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @categories.each do |category| %>
        <tr>
          <td class="px-4 py-3 text-gray-500"><%= category.position %></td>
          <td class="px-4 py-3 font-medium"><%= category.name %></td>
          <td class="px-4 py-3">
            <% if category.active? %>
              <span class="rounded-full bg-emerald-100 px-2 py-1 text-xs text-emerald-700">Ativa</span>
            <% else %>
              <span class="rounded-full bg-gray-100 px-2 py-1 text-xs text-gray-600">Inativa</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-right space-x-3">
            <%= link_to "Editar", edit_admin_category_path(category), class: "text-emerald-700 hover:underline" %>
            <%= button_to "Excluir", admin_category_path(category), method: :delete,
                  form: { data: { turbo_confirm: "Tem certeza que deseja excluir esta categoria?" } },
                  class: "text-red-600 hover:underline bg-transparent p-0" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
