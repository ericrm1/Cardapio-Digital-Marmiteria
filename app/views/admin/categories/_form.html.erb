<%= form_with model: [ :admin, category ], class: "space-y-4 rounded-xl bg-white p-6 shadow-sm" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-lg bg-red-100 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :description, "Descrição", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 3, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :position, "Posição", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.number_field :position, class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300" %>
    <%= f.label :active, "Ativa", class: "text-sm text-gray-700" %>
  </div>

  <%= f.submit "Salvar categoria", class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700" %>
<% end %>
